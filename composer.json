{
    "name": "phatnt93/php-upload-helper",
    "description": "A modern, secure and fluent PHP file upload and image manipulation library with first-class multi-file array support, inspired by class.upload.php.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Phat Nguyen",
            "email": "phatnt93@gmail.com"
        }
    ],
    "keywords": [
        "upload",
        "file-upload",
        "image-upload",
        "multi-upload",
        "image-manipulation",
        "resize",
        "crop",
        "watermark",
        "php",
        "class-upload"
    ],
    "homepage": "https://github.com/phatnt93/php-upload-helper",
    "support": {
        "issues": "https://github.com/phatnt93/php-upload-helper/issues",
        "source": "https://github.com/phatnt93/php-upload-helper"
    },
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3 || ^8.4",
        "ext-fileinfo": "*",
        "ext-mbstring": "*"
    },
    "suggest": {
        "ext-gd": "Required for default image manipulation driver (resize, crop, watermark, convert)",
        "ext-imagick": "Optional high-performance image manipulation driver",
        "ext-exif": "Required for EXIF auto-orientation of mobile photos"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "UploadHelper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UploadHelper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
