{
    "name": "phatnt93/php-upload-helper",
    "description": "A modern, secure and fluent PHP file upload and image manipulation library with first-class multi-file array support, inspired by class.upload.php.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Phat Nguyen",
            "email": "phatnt93@gmail.com"
        }
    ],
    "keywords": [
        "upload",
        "file-upload",
        "image-upload",
        "multi-upload",
        "batch-upload",
        "secure-upload",
        "file-validation",
        "mime-validation",
        "image-manipulation",
        "resize",
        "crop",
        "watermark",
        "webp",
        "avif",
        "gd",
        "psr-7",
        "ssrf",
        "class-upload"
    ],
    "homepage": "https://github.com/phatnt93/php-upload-helper",
    "readme": "README.md",
    "support": {
        "issues": "https://github.com/phatnt93/php-upload-helper/issues",
        "source": "https://github.com/phatnt93/php-upload-helper",
        "docs": "https://github.com/phatnt93/php-upload-helper#readme"
    },
    "require": {
        "php": "^8.1",
        "ext-fileinfo": "*",
        "ext-mbstring": "*"
    },
    "suggest": {
        "ext-gd": "Required for default image manipulation driver (resize, crop, watermark, convert)",
        "ext-imagick": "Optional high-performance image manipulation driver",
        "ext-exif": "Required for EXIF auto-orientation of mobile photos"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "UploadHelper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UploadHelper\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-clover=coverage/clover.xml",
            "@php tests/coverage-check.php coverage/clover.xml 90"
        ],
        "analyse": "phpstan analyse --memory-limit=512M",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
